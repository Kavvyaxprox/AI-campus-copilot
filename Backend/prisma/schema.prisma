// SQLite data source. See "File path resolution" in the Prisma SQLite docs:
// the `file:` URL is resolved relative to this schema file.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite via Prisma does not support native enums; role and status values are
// stored as plain strings and validated at the application layer.
model Department {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())

  users     User[]
  documents Document[]
  notices   Notice[]
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         String // SUPER_ADMIN | DEPT_ADMIN | FACULTY | STUDENT
  semester     Int?
  createdAt    DateTime   @default(now())

  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId String?

  documents    Document[]
  reports      ContentReport[]
  auditLogs    AuditLog[]

  @@index([role])
  @@index([departmentId])
}

model Document {
  id        String   @id @default(cuid())
  title     String
  category  String
  fileUrl   String
  fileName  String?
  pageCount Int      @default(0)
  chunkCount Int     @default(0)
  semester  Int?
  version   Int      @default(1)
  status    String   @default("PROCESSING") // PROCESSING | PUBLISHED | SUPERSEDED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId String?

  uploadedBy      User   @relation(fields: [uploadedByUserId], references: [id])
  uploadedByUserId String

  reports ContentReport[]

  @@index([title])
  @@index([departmentId, semester])
  @@index([status])
}

model Notice {
  id        String   @id @default(cuid())
  title     String
  body      String
  semester  Int?
  expiresAt DateTime?
  createdAt DateTime @default(now())

  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId String?

  @@index([departmentId, expiresAt])
}

model ContentReport {
  id         String    @id @default(cuid())
  query      String
  answer     String?
  reason     String
  detail     String?
  status     String    @default("OPEN") // OPEN | RESOLVED
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  document   Document? @relation(fields: [documentId], references: [id])
  documentId String?

  student    User @relation(fields: [studentId], references: [id])
  studentId  String

  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  // SQLite has no native Json column type; metadata is stored as a JSON string.
  metadata   String
  timestamp  DateTime @default(now())

  actor   User   @relation(fields: [actorId], references: [id])
  actorId String

  @@index([entityType, entityId])
  @@index([timestamp])
}
