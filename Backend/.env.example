# SQLite database file, resolved relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Required by the API. Generate a unique, high-entropy value.
JWT_SECRET=replace-with-a-long-random-secret

# Required by `npm run db:seed` for the super admin, and for all accounts in production.
# Development demo admin and student use the shared demo password documented in Agent.md.
SEED_SUPER_ADMIN_PASSWORD=replace-with-a-strong-password
SEED_DEPT_ADMIN_PASSWORD=replace-with-a-strong-password
SEED_STUDENT_PASSWORD=replace-with-a-strong-password
